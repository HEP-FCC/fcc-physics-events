# Template for the "dami-backend" OpenShift Secret in the new "fcc-dami" project.
#
# This is a NEW project but reuses the SAME EXISTING prod DBOD instance as
# the current "fcc-physics-events" project -- no new database, no data
# migration. Copy the POSTGRES_* and FILE_WATCHER_* values below from the
# current prod Secret rather than inventing them:
#
#   oc get secret fcc-physics-events-backend -n fcc-physics-events -o json \
#     | jq -r '.data | to_entries[] | "\(.key)=\(.value | @base64d)"'
#
# Then create this project's own Secret with the merged result:
#
#   oc create secret generic dami-backend -n fcc-dami --from-env-file=<your-filled-copy>
#
# No quotes around values -- `oc create secret --from-env-file` takes each
# line literally after the first `=`, quotes included, so quoting a value
# here would bake the literal quote characters into the Secret.

METADATA_BROWSER_FRONTEND_URL=https://fcc-dami.web.cern.ch
METADATA_BROWSER_BACKEND_URL=https://fcc-dami-backend.web.cern.ch

# Copy from the current fcc-physics-events-backend Secret -- same DBOD
# instance, same database, same credentials.
METADATA_BROWSER_POSTGRES_HOST=COPY_FROM_CURRENT_PROD_SECRET
METADATA_BROWSER_POSTGRES_PORT=COPY_FROM_CURRENT_PROD_SECRET
METADATA_BROWSER_POSTGRES_USER=COPY_FROM_CURRENT_PROD_SECRET
METADATA_BROWSER_POSTGRES_PASSWORD=COPY_FROM_CURRENT_PROD_SECRET
METADATA_BROWSER_POSTGRES_DB=COPY_FROM_CURRENT_PROD_SECRET

# config.conf's default main_table ("entities") doesn't match this project's
# actual schema (database.sql defines the main entity table as "datasets");
# this must mirror the current prod value or the app can't find its tables.
METADATA_BROWSER_MAIN_TABLE=datasets

# This DBOD instance only accepts encrypted connections. "require" encrypts
# without verifying the server certificate (unlike the "prefer" default,
# which silently falls back to plaintext -- and gets rejected -- if cert
# verification fails).
METADATA_BROWSER_POSTGRES_SSL_MODE=require

METADATA_BROWSER_LOG_LEVEL=INFO
METADATA_BROWSER_HTTPS_ONLY=true

# Real prod -- auth is enabled from day one, unlike staging's initial
# auth-disabled bootstrap. Register a NEW CERN Application Portal client for
# this project (fcc-dami is a distinct hostname from fcc-physics-events, so
# it needs its own OIDC client). CLIENT_ID/CLIENT_SECRET then come from the
# "oidc-client-secret" Secret that CERN's PaaS platform auto-provisions for
# this project (it's managed by PaaS itself, not editable via the generic
# CERN Application Portal):
#   oc get secret oidc-client-secret -n fcc-dami -o json | ...decode...
# REDIRECT_URI must match this backend's own callback route exactly.
# AUTH_OIDC_URL/AUTH_ISSUER come from that same Secret's issuerURL.
METADATA_BROWSER_AUTH_ENABLED=true
METADATA_BROWSER_COOKIE_PREFIX=dami
# METADATA_BROWSER_CERN_CLIENT_ID=
# METADATA_BROWSER_CERN_CLIENT_SECRET=
METADATA_BROWSER_CERN_REDIRECT_URI=https://fcc-dami-backend.web.cern.ch/auth
METADATA_BROWSER_AUTH_OIDC_URL=https://auth.cern.ch/auth/realms/cern/.well-known/openid-configuration
METADATA_BROWSER_AUTH_ISSUER=https://auth.cern.ch/auth/realms/cern

# CERN role that grants the admin tier (see backend/app/config.conf). Create
# it in the new Application Portal registration's Roles tab (can reuse the
# "dami-admin" Role Identifier and the same
# fcc-ped-softwareandcomputing-mcproduction-admin e-group as staging, but
# it's a fresh role tied to this new client -- confirm when registering it).
METADATA_BROWSER_ADMIN_CERN_ROLE=dami-admin

# Required by config.conf regardless of auth state; generate your own, e.g.
# `openssl rand -hex 32`. Do NOT reuse the current prod project's key.
METADATA_BROWSER_APPLICATION_SECRET_KEY=CHANGE_ME

METADATA_BROWSER_TITLE=Dataset Metadata Interface

# File watcher reads real FCC config files from EOS (see the eos-volume PVC
# mount in backend-deployment.yaml) -- copy the real watch path(s) from the
# current prod Secret, do not reuse staging's /backend-storage path.
#
# Disabled for now: the current fcc-physics-events project is still the one
# ingesting from EOS into the shared DBOD database. Running both watchers at
# once would have them race/duplicate-process the same files into the same
# DB. Flip to true (or just delete this line) once fcc-dami becomes the sole
# ingestion path, as part of the old project's decommission -- see TODO.md.
METADATA_BROWSER_FILE_WATCHER_ENABLED=false
METADATA_BROWSER_STARTUP_MODE=process_new
METADATA_BROWSER_STATE_FILE=/backend-storage/file_watcher_state.json
METADATA_BROWSER_FILE_WATCHER_LOCK_FILE=/backend-storage/file_watcher.lock
METADATA_BROWSER_FILE_WATCHER_PATHS=COPY_FROM_CURRENT_PROD_SECRET
METADATA_BROWSER_FILE_WATCHER_EXTENSIONS=.json
