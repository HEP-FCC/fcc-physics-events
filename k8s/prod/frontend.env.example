# Template for the "dami-frontend" OpenShift Secret in the new "fcc-dami" project.
# No actual secrets in here.
#
#   oc create secret generic dami-frontend -n fcc-dami --from-env-file=k8s/prod/frontend.env.example

METADATA_BROWSER_BACKEND_URL=https://fcc-dami-backend.web.cern.ch

# Nitro overrides public runtime config at container startup via
# NUXT_PUBLIC_<KEY> -- this is what actually takes effect at runtime, since
# METADATA_BROWSER_BACKEND_URL above only sets the value baked in at Docker
# build time. Keep both in sync.
NUXT_PUBLIC_API_BASE_URL=https://fcc-dami-backend.web.cern.ch
