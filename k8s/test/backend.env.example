# Template for the "dami-backend" OpenShift Secret in the fcc-dami-test project.
#
# Copy this file somewhere outside git (e.g. your scratchpad), fill in the
# password below, then create the Secret with:
#
#   oc create secret generic dami-backend -n fcc-dami-test --from-env-file=<your-filled-copy>
#
# No quotes around values -- `oc create secret --from-env-file` takes each
# line literally after the first `=`, quotes included, so quoting a value
# here would bake the literal quote characters into the Secret.

METADATA_BROWSER_FRONTEND_URL=https://fcc-dami-test.web.cern.ch
METADATA_BROWSER_BACKEND_URL=https://fcc-dami-test-backend.web.cern.ch

METADATA_BROWSER_POSTGRES_HOST=dbod-fcc-dami-test.cern.ch
METADATA_BROWSER_POSTGRES_PORT=6608
METADATA_BROWSER_POSTGRES_USER=dami_test_app
METADATA_BROWSER_POSTGRES_PASSWORD=CHANGE_ME
METADATA_BROWSER_POSTGRES_DB=dami_test

METADATA_BROWSER_LOG_LEVEL=DEBUG
METADATA_BROWSER_HTTPS_ONLY=true

# Auth disabled for now so the team can exercise the new DSL/API without
# needing CERN SSO set up on this instance first. Flip to true + fill in the
# CERN OAuth vars below if you want to test the auth path too.
METADATA_BROWSER_AUTH_ENABLED=false
METADATA_BROWSER_COOKIE_PREFIX=dami-test

# Only needed if METADATA_BROWSER_AUTH_ENABLED=true
# METADATA_BROWSER_CERN_CLIENT_ID=
# METADATA_BROWSER_CERN_CLIENT_SECRET=
# METADATA_BROWSER_AUTH_OIDC_URL=https://auth.cern.ch/auth/realms/cern/.well-known/openid_configuration
# METADATA_BROWSER_AUTH_ISSUER=https://auth.cern.ch/auth/realms/cern

# Required by config.conf regardless of auth state; generate your own, e.g.
# `openssl rand -hex 32`.
METADATA_BROWSER_APPLICATION_SECRET_KEY=CHANGE_ME

# Visually distinguish this instance from prod in the UI.
METADATA_BROWSER_TITLE=DaMI (staging)

METADATA_BROWSER_STARTUP_MODE=process_new
METADATA_BROWSER_STATE_FILE=/backend-storage/file_watcher_state.json
METADATA_BROWSER_FILE_WATCHER_LOCK_FILE=/backend-storage/file_watcher.lock
METADATA_BROWSER_FILE_WATCHER_PATHS=/backend-storage/incoming
METADATA_BROWSER_FILE_WATCHER_EXTENSIONS=.json
