# Template for running the backend natively (uv run) against a local Postgres
# container, instead of staging/prod.
#
# Copy this file to local-dev/backend.env (already gitignored), fill in a
# secret key below, then start Postgres (see local-dev/README.md) and run:
#
#   cd backend && uv run --env-file ../local-dev/backend.env uvicorn app.main:app --reload --no-access-log

METADATA_BROWSER_FRONTEND_URL=http://localhost:3000
METADATA_BROWSER_BACKEND_URL=http://localhost:8000

METADATA_BROWSER_POSTGRES_HOST=localhost
METADATA_BROWSER_POSTGRES_PORT=5432
METADATA_BROWSER_POSTGRES_USER=dami_local
METADATA_BROWSER_POSTGRES_PASSWORD=dami_local
METADATA_BROWSER_POSTGRES_DB=dami_local

# config.conf's default main_table ("entities") doesn't match this project's
# actual schema (database.sql defines the main entity table as "datasets");
# this must mirror prod's value or the app can't find its own tables.
METADATA_BROWSER_MAIN_TABLE=datasets

METADATA_BROWSER_LOG_LEVEL=DEBUG
METADATA_BROWSER_HTTPS_ONLY=false

# Auth disabled for local development -- no CERN SSO setup needed.
METADATA_BROWSER_AUTH_ENABLED=false
METADATA_BROWSER_COOKIE_PREFIX=dami-local

# Required by config.conf regardless of auth state; generate your own, e.g.
# `openssl rand -hex 32`.
METADATA_BROWSER_APPLICATION_SECRET_KEY=CHANGE_ME

METADATA_BROWSER_TITLE="Dataset Metadata Interface - local dev"

METADATA_BROWSER_STARTUP_MODE=process_new
METADATA_BROWSER_STATE_FILE=../local-dev/storage/file_watcher_state.json
METADATA_BROWSER_FILE_WATCHER_LOCK_FILE=../local-dev/storage/file_watcher.lock
METADATA_BROWSER_FILE_WATCHER_PATHS=../local-dev/storage/incoming
METADATA_BROWSER_FILE_WATCHER_EXTENSIONS=.json
